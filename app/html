<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>ARCHIVE MARKET</title>
  <!-- Официальный скрипт с защитой от старого кэша -->
  <script src="https://telegram.org/js/telegram-web-app.js?v=999"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; -webkit-tap-highlight-color: transparent; }
    body { background-color: #0b0b0e !important; color: #f5f5f7; padding: 16px 14px 90px; min-height: 100vh; }
    header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 16px; border-bottom: 1px solid #1f1f27; padding-bottom: 12px; }
    h1 { font-size: 20px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; }
    .badge { font-size: 11px; background: #1f1f27; color: #a1a1aa; padding: 4px 8px; border-radius: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
    .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .card { background: #15151c; border-radius: 12px; overflow: hidden; border: 1px solid #23232e; display: flex; flex-direction: column; cursor: pointer; transition: transform 0.1s ease, border-color 0.1s ease; }
    .card:active { transform: scale(0.98); }
    .card.selected { border-color: #ffffff; box-shadow: 0 0 0 1px #ffffff; }
    .img-wrap { width: 100%; height: 150px; background: #1c1c26; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .img-wrap img { width: 100%; height: 100%; object-fit: cover; }
    .tag { position: absolute; top: 8px; left: 8px; background: rgba(11, 11, 14, 0.85); color: #fff; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.5px; z-index: 2; }
    .info { padding: 10px; display: flex; flex-direction: column; gap: 4px; flex-grow: 1; }
    .brand { font-size: 10px; color: #8e8e93; text-transform: uppercase; font-weight: 700; letter-spacing: 0.8px; }
    .title { font-size: 13px; font-weight: 600; color: #ededed; line-height: 1.2; }
    .meta { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; }
    .size { font-size: 11px; color: #a1a1aa; background: #1c1c26; padding: 2px 6px; border-radius: 4px; }
    .price { font-size: 13px; font-weight: 700; color: #fff; }
    .status-bar { position: fixed; bottom: 0; left: 0; right: 0; background: rgba(15, 15, 20, 0.95); backdrop-filter: blur(10px); border-top: 1px solid #23232e; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; z-index: 100; }
    .status-text { font-size: 12px; color: #8e8e93; }
  </style>
</head>
<body>
  <header>
    <div>
      <h1>ARCHIVE</h1>
      <span style="font-size: 11px; color: #8e8e93;">CURATED PIECES</span>
    </div>
    <span class="badge">STOCK: 4</span>
  </header>

  <div class="grid">
    <div class="card" onclick="selectItem('MAISON MARGIELA', 'Fusion Distressed Lows', '42 EU', 54000, this)">
      <div class="img-wrap"><span class="tag">ARCHIVE</span><img src="https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?w=400&q=80" alt="Item"></div>
      <div class="info"><span class="brand">MAISON MARGIELA</span><span class="title">Fusion Distressed Lows</span><div class="meta"><span class="size">42 EU</span><span class="price">54 000 ₽</span></div></div>
    </div>
    <div class="card" onclick="selectItem('RICK OWENS', 'Bauhaus Cargo Heavy', 'M (48)', 68000, this)">
      <div class="img-wrap"><span class="tag">RARE</span><img src="https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?w=400&q=80" alt="Item"></div>
      <div class="info"><span class="brand">RICK OWENS</span><span class="title">Bauhaus Cargo Heavy</span><div class="meta"><span class="size">M (48)</span><span class="price">68 000 ₽</span></div></div>
    </div>
    <div class="card" onclick="selectItem('BALENCIAGA', 'Mud Washed Zip Hoodie', 'L / Oversize', 89000, this)">
      <div class="img-wrap"><span class="tag">RUNWAY</span><img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=400&q=80" alt="Item"></div>
      <div class="info"><span class="brand">BALENCIAGA</span><span class="title">Mud Washed Zip Hoodie</span><div class="meta"><span class="size">L / Oversize</span><span class="price">89 000 ₽</span></div></div>
    </div>
    <div class="card" onclick="selectItem('CHROME HEARTS', 'Dagger Leather Bag', 'ONE SIZE', 145000, this)">
      <div class="img-wrap"><span class="tag">GRAIL</span><img src="https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=400&q=80" alt="Item"></div>
      <div class="info"><span class="brand">CHROME HEARTS</span><span class="title">Dagger Leather Bag</span><div class="meta"><span class="size">ONE SIZE</span><span class="price">145 000 ₽</span></div></div>
    </div>
  </div>

  <div class="status-bar">
    <span class="status-text" id="statusText">Нажмите на вещь для выбора</span>
    <span class="badge" style="background:#23232e; color:#fff;">СДЭК / РФ</span>
  </div>

  <script>
    let selectedData = null;
    const tg = window.Telegram?.WebApp;

    if (tg) {
      tg.ready();
      tg.expand();
      tg.MainButton.setParams({ color: '#ffffff', text_color: '#000000' });
      tg.MainButton.onClick(() => {
        if (selectedData) tg.sendData(JSON.stringify(selectedData));
      });
    }

    function selectItem(brand, title, size, price, el) {
      document.querySelectorAll('.card').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');
      selectedData = { brand, title, size, price };
      document.getElementById('statusText').innerText = brand + ' - ' + price.toLocaleString('ru-RU') + ' ₽';
      
      if (tg) {
        tg.MainButton.setText('ЗАБРОНИРОВАТЬ ЗА ' + price.toLocaleString('ru-RU') + ' ₽');
        tg.MainButton.show();
      }
    }
  </script>
</body>
</html>
